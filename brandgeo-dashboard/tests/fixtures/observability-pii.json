    },
    {
      "name": "PostgREST non-Error: details and hint are dropped, the message and pg_code stay",
      "input": {
        "exception": {
          "values": [
            {
              "type": "NonError",
              "value": "duplicate key value violates unique constraint"
            }
          ]
        },
        "tags": {
          "fn": "collect-prompt",
          "pg_code": "23505"
        },
        "extra": {
