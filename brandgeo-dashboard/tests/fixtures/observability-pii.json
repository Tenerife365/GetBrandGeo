  "server_capture_cases": [
    {
      "name": "PostgREST error object: only message and the string code are read",
      "input": {
        "message": "duplicate key value violates unique constraint",
        "details": "Failing row contains (12, ops@example.com)",
        "hint": "Check the row",
        "code": "23505"
      },
      "expected": {
        "exception": {
          "type": "NonError",
          "value": "duplicate key value violates unique constraint"
        },
        "pg_code": "23505"
      },
      "must_not_contain": [
        "Failing row",
        "Check the row",
        "ops@example.com"
      ]
    },
    {
      "name": "non-Error with a numeric code: no pg_code tag",
      "input": {
        "message": "upstream said no",
        "code": 500
      },
      "expected": {
        "exception": {
          "type": "NonError",
          "value": "upstream said no"
        },
        "pg_code": null
      },
      "must_not_contain": []
    }
  ]
