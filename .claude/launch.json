{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "brandgeo-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "brandgeo-dashboard",
      "port": 5173
    },
    {
      "name": "brandgeo-next",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "brandgeo-next",
      "port": 3000
    },
    {
      "name": "brandgeo-web",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8899", "--directory", "brandgeo/web"],
      "port": 8899
    },
    {
      "name": "brandgeo-next-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve@14", "out", "-l", "4173"],
      "cwd": "brandgeo-next",
      "port": 4173
    }
  ]
}
