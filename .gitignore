# brandgeo/ — ignore everything except the public website files
brandgeo/*
!brandgeo/web/
# ...but never the deploy webhook secret or its log. These live only on the
# server (uploaded by hand), must stay out of git, and must never be copied
# into the public docroot by the webhook deploy.
brandgeo/web/deploy-secret.php
brandgeo/web/deploy.log


# Secrets — never commit these
.env
credentials.json
token.json


# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class


# C extensions
*.so


# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
!brandgeo-dashboard/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Ayrshare SSO integration package: contains the RSA private key and the
# account API key. Never commit it.
integration-guides_*.zip
*-private-key.key
*.pem
integration-guides_*/

# Quarantined stray copies from the 2026-07-24 repo reorg — redundant dups of
# now-tracked files, the 3 differing spec variants, and local-only secrets.
# Review and delete when confirmed unneeded. Never commit (contains secrets).
/_reorg-stray/
.aidesigner/*
!.aidesigner/.gitkeep

# Piper voice models: ~63MB each, re-downloadable in seconds with
# `python -m piper.download_voices <name> --download-dir assets/voices`.
# The .json configs and the licence README ARE tracked, so the licence
# decision survives even though the weights do not.
assets/voices/**/*.onnx
assets/audio/*.wav
assets/samples/*.wav
email-preview.html

# -- Social and campaign output: LOCAL ONLY, ruled by Constantin 2026-08-01 ---
# Nothing under these paths belongs in git or in Netlify. It is social media
# output: it is never served by the site, never imported by the app, and it is
# large. 581 MB of it was one command away from entering a PUBLIC repo whose
# history is permanent, where removing it later needs a rewrite rather than a
# delete.
#
# WHERE IT GOES INSTEAD: a shared drive, so the other cofounders can reach it.
# That drive does not exist yet. Until it does, the ONLY copy is the machine
# that rendered it, so treat these folders as unbacked-up.
#
# THE LINE THAT MATTERS, because it is easy to get backwards: articles under
# brandgeo/web/ MUST stay tracked. cPanel does not receive files directly; the
# publish path is a GitHub webhook into deploy.php, so an uncommitted article
# is an unpublished article. Git is the marketing site's deploy mechanism and
# the social pipeline's storage medium is not git at all.
#
# Everything else in docs/growth/ stays tracked on purpose: the sprint registry,
# outbound-infra, the voice kit, brand identity and data templates are decisions
# and specs, not renders.
docs/growth/CAMPAIGN-*/
docs/growth/reel-campaign-ab/
assets/audio/music/
