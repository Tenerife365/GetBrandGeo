# brandgeo/ — ignore everything except the public website files
brandgeo/*
!brandgeo/web/
# ...but never the deploy webhook secret or its log. These live only on the
# server (uploaded by hand), must stay out of git, and must never be copied
# into the public docroot by the webhook deploy.
brandgeo/web/deploy-secret.php
brandgeo/web/deploy.log


# Secrets — never commit these
.env
credentials.json
token.json


# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class


# C extensions
*.so


# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
!brandgeo-dashboard/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Ayrshare SSO integration package: contains the RSA private key and the
# account API key. Never commit it.
integration-guides_*.zip
*-private-key.key
*.pem
integration-guides_*/

# Quarantined stray copies from the 2026-07-24 repo reorg — redundant dups of
# now-tracked files, the 3 differing spec variants, and local-only secrets.
# Review and delete when confirmed unneeded. Never commit (contains secrets).
/_reorg-stray/
.aidesigner/*
!.aidesigner/.gitkeep

# Piper voice models: ~63MB each, re-downloadable in seconds with
# `python -m piper.download_voices <name> --download-dir assets/voices`.
# The .json configs and the licence README ARE tracked, so the licence
# decision survives even though the weights do not.
assets/voices/**/*.onnx
assets/audio/*.wav
assets/samples/*.wav
email-preview.html

# ── Rendered campaign media ─────────────────────────────────────────────────
# 551 MB across 188 files as of 2026-08-01, and this repo is PUBLIC, so a commit
# is permanent: removing it later needs a history rewrite, not a delete.
#
# All of it is OUTPUT and all of it is regenerable. The Remotion project at
# brandgeo-video/ is tracked (and already gitignores its own out/), and the
# music comes from scripts/compose_music.py. reel-campaign-ab/ in particular is
# intermediate A/B renders across six timestamped runs of the same day.
#
# PNG is deliberately NOT ignored: 192 files at 26 MB total are the actual
# publishable post images, small, and not trivially reproducible.
docs/growth/CAMPAIGN-*/**/*.mp4
docs/growth/CAMPAIGN-*/**/*.wav
docs/growth/reel-campaign-ab/**/*.mp4
docs/growth/reel-campaign-ab/**/*.wav
assets/audio/music/*.wav
