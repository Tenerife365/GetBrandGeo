# ─── Security Headers — getbrandgeo.com ───────────────────────────────────────

<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "DENY"

  # Prevent MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Control referrer information
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Disable browser features not needed on a marketing site
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Force HTTPS for 1 year (only enable once HTTPS is confirmed working)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Content Security Policy
  # - Plausible was removed 2026-08-02 (subscription lapsed) and plausible.io is
  #   deliberately NOT in script-src or connect-src any more. Re-adding the
  #   allowlist entry without re-adding the tag buys nothing and widens the
  #   policy; if Plausible ever comes back, both change together.
  # - Google Analytics / GA4 (googletagmanager.com loader; google-analytics.com
  #   and its regional subdomains for the actual hit-collection endpoint —
  #   without these, gtag.js loads but every hit is silently blocked)
  # - Google Fonts (fonts.googleapis.com, fonts.gstatic.com)
  # - FormSubmit.co contact form
  # NOTE: inline <script> blocks are NOT allowed by this policy (no
  # 'unsafe-inline' in script-src, deliberately). Any script logic must live
  # in an external, same-origin .js file (e.g. site.js, ga4-init.js) or it
  # will be silently blocked by the browser with no visible error to a normal
  # user — this bit the GA4 rollout and every page with its own inline
  # theme-toggle script on 2026-07-13. Verify any new inline script actually
  # runs (check window/document state in a live browser), don't just confirm
  # the tag exists in page source.
  # askmywebsiteai (support assistant, injected from site.js). Its SDK loads
  # from app.askmywebsiteai.com, injects its own stylesheet and font, talks
  # back to the same origin it was served from, and can open an iframe, hence
  # the entry in five directives. No wss: needed, it uses plain fetch. Note a
  # wildcard would NOT cover the apex, so the host is listed literally.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://app.askmywebsiteai.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://app.askmywebsiteai.com; font-src 'self' https://fonts.gstatic.com https://app.askmywebsiteai.com; img-src 'self' data: https:; frame-src 'self' https://app.askmywebsiteai.com; connect-src 'self' https://app.getbrandgeo.com https://formsubmit.co https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://app.askmywebsiteai.com; form-action https://formsubmit.co 'self'; frame-ancestors 'none'"
</IfModule>

# ─── Force HTTPS ───────────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ─── Prevent directory listing ────────────────────────────────────────────────

Options -Indexes
